rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? me().data.role : 'none'; }
    function isOwner() { return role() == 'owner'; }
    function isManager() { return role() == 'owner' || role() == 'head' || role() == 'manager'; }
    function isStaff() { return isManager() || role() == 'staff' || role() == 'parttime'; }

    // 직원 프로필: 본인은 읽기, 관리자는 읽기/쓰기. 첫 사장님은 본인 프로필을 직접 만들 수 있음 (settings.ownerUid 가 없을 때)
    match /users/{uid} {
      allow read: if isStaff() || request.auth.uid == uid;
      allow create: if isManager() || (request.auth.uid == uid && !exists(/databases/$(database)/documents/settings/main));
      allow update, delete: if isOwner() || (isManager() && resource.data.role != 'owner');
    }
    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if isOwner() || !exists(/databases/$(database)/documents/settings/main);
    }
    // 출퇴근: 본인 기록 생성/수정, 관리자 전체 수정
    match /attendance/{id} {
      allow read: if isStaff();
      allow create, update: if isManager() || (isStaff() && request.resource.data.uid == request.auth.uid);
      allow delete: if isManager();
    }
    // 근무표·근무 템플릿·스케줄·체크리스트 템플릿·직원 관리: 관리자만 쓰기
    match /shifts/{id} { allow read: if isStaff(); allow write: if isManager(); }
    match /shiftTemplates/{id} { allow read: if isStaff(); allow write: if isManager(); }
    match /schedule/{id} { allow read: if isStaff(); allow write: if isManager(); }
    match /checklistTemplates/{id} { allow read: if isStaff(); allow write: if isManager(); }
    match /stockConfig/{id} { allow read: if isStaff(); allow write: if isManager(); }
    match /manual/{id} { allow read: if isStaff(); allow write: if isManager(); }
    // 일일 기록: 직원 모두 쓰기
    match /checklists/{id} { allow read, write: if isStaff(); }
    match /cleaning/{id} { allow read, write: if isStaff(); }
    match /stock/{id} { allow read, write: if isStaff(); }
    match /logs/{id} { allow read, write: if isStaff(); }

    // 매장 운영 배정표(ops/): 배정표가 이 기기에 저장하는 내용을 컴퓨터끼리 공유. 문서 하나 = 저장 키 하나.
    // 배정표는 이름+네 자리로 들어오므로 Firebase 익명 로그인을 켜 두고, 로그인된 누구나 읽고 쓴다.
    match /ops/{key} {
      allow read: if signedIn();
      allow delete: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['v','by','t'])
        && request.resource.data.v is string
        && request.resource.data.v.size() <= 200000;
    }

    // 브랜드 북 워크북(workbook/): 수강생은 로그인 없이 "이름_뒤4자리" 문서 하나만 읽고 씀.
    // 목록 조회(list)는 막아 다른 수강생 답을 훑어볼 수 없게 하고, 필드·크기를 제한한다.
    match /workbook/{id} {
      function wbOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name','code','day','a','updatedAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 30
          && d.code is string && d.code.matches('^[0-9]{4}$')
          && d.day is number && d.a is map && d.updatedAt is number
          && id == d.name.replace('[/\\s]+', '') + '_' + d.code;
      }
      allow get: if true;
      allow list: if isManager();
      allow create, update: if wbOk();
      allow delete: if isManager();
    }
  }
}
